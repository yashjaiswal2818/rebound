# Rebound Multi-App Agent Environment Variables
# Copy to .env and fill in your keys

# Duffel API (Use test mode: starts with duffel_test_)
DUFFEL_API_KEY=duffel_test_your_key_here

# Free-Tier LLM: Google Gemini (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Anthropic (Optional alternative)
ANTHROPIC_API_KEY=

# Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
TRAVELER_PHONE=+15550000001

# Google Workspace (OAuth2 paths)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Agent Policy Controls
DRY_RUN=false
SPEND_CEILING_USD=800.0
APPROVAL_THRESHOLD_USD=300.0

